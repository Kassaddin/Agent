{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate topic checkpoint version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "topic", "decision_record", "caller", "objective", "scope", "current_step", "handoff", "decision_refs", "blockers", "artifact_updates", "next_action", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "topic": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "decision_record": {"type": "object", "additionalProperties": false, "required": ["resource", "path"], "properties": {"resource": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}},
    "caller": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "current_step": {"type": "string", "minLength": 1},
    "handoff": {"type": ["string", "null"]},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_updates": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact", "owner", "state", "evidence"],
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "state": {"enum": ["pending", "applied", "verified"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "next_action": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
